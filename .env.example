# PiQuaChu environment template (Phase 4)
# ---------------------------------------------------------------------------
# Copy to .env and replace every placeholder. This file contains NO real
# secrets: values below are obvious placeholders or documented defaults.
# Never commit a filled-in .env.
# ---------------------------------------------------------------------------

# ---- Deployment identity ---------------------------------------------------
# development | production. Production enables fail-closed config validation
# (no built-in dev keys, no wildcard CORS, no multi-worker in-memory limiter).
PIQUACHU_ENV=development

# local (single-user, frictionless) | team (tenant-scoped API keys + RBAC)
PIQUACHU_TENANCY_MODE=local

# Team mode only: keep legacy shared PIQUACHU_API_KEYS working during a
# migration window. Disable after every team has its own keys.
PIQUACHU_LEGACY_ENV_KEYS=0

# ---- Shared key (local mode / migration only) ------------------------------
# Comma-separated. Minimum 16 characters each; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# In production this is REQUIRED unless team keys are provisioned first.
PIQUACHU_API_KEYS=

# ---- Key verifier pepper ---------------------------------------------------
# HMAC-SHA256 pepper for stored API-key verifiers. Set a long random value in
# production: python -c "import secrets; print(secrets.token_hex(32))"
PIQUACHU_KEY_PEPPER=

# ---- Storage ---------------------------------------------------------------
# Default: backend/piquachu.db (SQLite + WAL). Single-host only.
PIQUACHU_DB_PATH=

# ---- HTTP ------------------------------------------------------------------
PORT=5000
# Comma-separated exact origins (scheme://host:port). Wildcards are refused in
# production. Default: http://localhost:5173..5176
PIQUACHU_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Only list a reverse proxy here if it overwrites X-Forwarded-For; otherwise the
# header is ignored and the socket peer is the rate-limit identity.
PIQUACHU_TRUSTED_PROXIES=

# ---- Rate limiting ---------------------------------------------------------
# memory:// = single process only (development default). In team/production,
# point this at Redis (or set PIQUACHU_BROKER_URL and it is reused).
PIQUACHU_RATE_LIMIT_STORAGE_URI=memory://
# closed = refuse requests (503) when the limiter backend is unavailable.
# degraded = allow requests during an outage (documented fail-open).
PIQUACHU_RATE_LIMIT_FAILURE_MODE=closed
# gunicorn worker count (used for the in-memory limiter safety check).
PIQUACHU_WORKERS=1
# Per-route limits (Flask-Limiter syntax). Defaults shown.
# PIQUACHU_RATE_LIMIT_SCAN=10 per hour
# PIQUACHU_RATE_LIMIT_POLL=120 per minute
# PIQUACHU_RATE_LIMIT_LOGS=120 per minute
# PIQUACHU_RATE_LIMIT_TELEMETRY=30 per hour
# PIQUACHU_RATE_LIMIT_EXPORTS=60 per minute
# PIQUACHU_RATE_LIMIT_ASSISTANT=30 per minute
# PIQUACHU_RATE_LIMIT_ADMIN=30 per hour
# PIQUACHU_RATE_LIMIT_HEALTH=120 per minute

# ---- Background jobs (optional Celery) -------------------------------------
# Leave empty for in-process threads (single host). For a Celery worker set a
# broker URL and use redis:// or rediss:// with authentication/TLS off-host.
PIQUACHU_BROKER_URL=
# Seconds Redis keeps an unacked message invisible before redelivery after a
# hard worker kill. Lower = faster recovery; higher = fewer duplicate runs.
PIQUACHU_CELERY_VISIBILITY_TIMEOUT=3600
# Recovery age for thread-mode PENDING/ANALYSING rows (never fails live jobs).
PIQUACHU_ORPHAN_GRACE_SECONDS=3600

# ---- Upload / input budgets ------------------------------------------------
PIQUACHU_MAX_UPLOAD_BYTES=52428800
PIQUACHU_MAX_UNCOMPRESSED_BYTES=262144000
PIQUACHU_MAX_ZIP_ENTRIES=5000
PIQUACHU_MAX_ZIP_FILE_BYTES=26214400
PIQUACHU_MAX_COMPRESSION_RATIO=200
PIQUACHU_MAX_BASELINE_BYTES=8388608
PIQUACHU_MAX_QUESTION_LENGTH=2000
PIQUACHU_MAX_TELEMETRY_ITEMS=500
PIQUACHU_STALE_UPLOAD_SECONDS=21600

# ---- Audit -----------------------------------------------------------------
# Structured JSONL audit stream (0600). The same events are stored in SQLite.
PIQUACHU_AUDIT_LOG=
PIQUACHU_AUDIT_DISABLED=0
PIQUACHU_AUDIT_MAX_BYTES=5242880
PIQUACHU_AUDIT_BACKUPS=3
PIQUACHU_AUDIT_RETENTION_DAYS=90

# ---- Remote AI (opt-in, metadata-only egress) ------------------------------
# Empty = local rule engine only. When set, only allowlisted finding metadata
# (rule, category, standard, target, language, severity, opaque rec id) and the
# user's question leave the machine. Source, paths, snippets and secrets never do.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Optional external validation report path ------------------------------
PIQUACHU_EXTERNAL_REPORT=
